{
  "rules": {
    "rooms": { ".read": true, ".write": true },
    "presence": { ".read": true, ".write": true },
    "stats": { ".read": true, ".write": true },
    "globalCustomWords": { ".read": true, ".write": true },
    "pairVotes": {
      ".read": true,
      ".write": true,
      "$pair": {
        "voters": {
          "$voter": { ".validate": "newData.hasChildren(['playerId', 'at'])" }
        }
      }
    },
    "learnedPairs": {
      ".read": true,
      ".write": true,
      "$pair": { ".validate": "newData.val() === true" }
    }
  }
}
